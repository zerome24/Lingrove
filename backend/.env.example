# LINGROVE — Backend Environment Configuration
# Project: LINGROVE
# Subtitle: Lingala Bamboo Products at CMRTC
# Tagline: Learn. Create. Sell. Grow Together.

# Database Configuration (MySQL 8.0 or local SQLite)
# If DATABASE_URL is omitted or unreachable, backend defaults to local SQLite (lingrove.db)
DATABASE_URL=sqlite:///lingrove.db
# For production MySQL: mysql+pymysql://<user>:<password>@<host>:3306/<database>

# Security Secrets & Environment
ENVIRONMENT=development
JWT_SECRET=your_jwt_secret_key_here_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated, never include wildcard '*' in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# YouTube Data API v3 (For discovering bamboo craft & machinery tutorials)
# Optional: If omitted, platform seamlessly uses verified curated educational bamboo video library
# Obtain from Google Cloud Console -> APIs & Services -> YouTube Data API v3
YOUTUBE_API_KEY=

# Google Gemini AI Assistant (For Lingua Multilingual Voice & Text Assistant)
# Optional: If omitted, platform seamlessly uses intelligent rule-based multilingual fallback
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Official Business WhatsApp Destination (International format for India: 919059076675)
WHATSAPP_NUMBER=919059076675


